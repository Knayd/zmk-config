#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

// Layers
#define _BASE 0
#define _MAC_BASE 1
#define _SYM 2
#define _NAV 3
#define _WIN 4
#define _NUM 5
#define _CONFIG 6
#define _GAME 7
#define _SWAP_FLAG 8

// keys
#define _______ &trans

#define KEYS_LEFT 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33
#define KEYS_RIGHT 7 8 9 10 11 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39
#define KEYS_THUMB 40 41 42 43 44 45

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMB>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMB>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        swap_layer {
            if-layers = <_SWAP_FLAG>;
            then-layer = <_MAC_BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &kp ESC     &kp Q         &kp W         &kp E           &kp R           &kp T       &mkp MB2           &kp C_VOL_UP     &kp Y       &kp U           &kp I           &kp O           &kp P           &kp PSCRN
                &kp BSPC    &hml LGUI A   &hml LALT S   &hml LSHFT D    &hml LCTRL F    &kp G       &mkp MB1           &kp C_VOL_DN     &kp H       &hmr LCTRL J    &hmr LSHFT K    &hmr LALT L     &hmr LGUI SQT   &kp SEMI
                &kp DEL     &kp Z         &kp X         &kp C           &kp V           &kp B                                           &kp N       &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp CAPS
                                                        &mo _NUM        &lt _NAV TAB    &lt _WIN RET                                    &kp LSHIFT  &lt _SYM SPACE  &mo _CONFIG
            >;
        };

        mac_base_layer {
            display-name = "MAC BASE";
            bindings = <
                _______ _______      _______ _______ _______     _______ _______      _______ _______ _______     _______ _______ _______        _______
                _______ &hml LCTRL A _______ _______ &hml LGUI F _______ _______      _______ _______ &hmr LGUI J _______ _______ &hmr LCTRL SQT _______
                _______ _______      _______ _______ _______     _______                      _______ _______     _______ _______ _______        _______
                                             _______ _______     _______                      _______ _______     _______
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
                _______ &kp CARET &kp HASH  &kp DQT     &kp DLLR    _______     _______             _______ &kp ASTRK   &kp PRCNT   &kp AMPS &kp PIPE   &kp PLUS    _______
                _______ &kp MINUS &kp LT    &kp GT      &kp EQUAL   &kp GRAVE   _______             _______ &kp EXCL    &kp LPAR    &kp RPAR &kp COLON  &kp UNDER   _______
                _______ &kp BSLH  &kp LBKT  &kp RBKT    &kp AT      _______                                 &kp TILDE   &kp LBRC    &kp RBRC _______    &kp QMARK   _______
                                            _______     &kp SPACE   _______                                 _______     _______     _______
            >;
        };

        nav_layer {
            display-name = "NAVIGATON";
            bindings = <
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______                      _______ _______ _______ _______ _______ _______
                                        _______ _______ _______                      _______ _______ _______
            >;
        };

        win_layer {
            display-name = "WINMAN";
            bindings = <
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______                      _______ _______ _______ _______ _______ _______
                                        _______ _______ _______                      _______ _______ _______
            >;
        };

        num_layer {
            display-name = "NUMBERS";
            bindings = <
                _______ _______ _______ _______ _______ _______ _______      _______ &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp PLUS  _______
                _______ _______ _______ _______ _______ _______ _______      _______ &kp SLASH  &kp N4  &kp N5  &kp N6  &kp MINUS _______
                _______ _______ _______ _______ _______ _______                      _______    &kp N1  &kp N2  &kp N3  &kp DOT   &kp EQUAL
                                        _______ _______ _______                      &kp N0     _______ _______
            >;
        };

        config_layer {
            display-name = "CONFIG";
            bindings = <
                &bootloader _______ _______ _______ _______ _______ _______      _______ _______        _______         _______         _______         _______ &bootloader
                _______     _______ _______ _______ _______ _______ _______      _______ &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    _______ _______
                _______     _______ _______ _______ _______ _______                      _______        &to _BASE       &to _SWAP_FLAG  _______         _______ _______
                                            _______ _______ _______                      _______        _______         _______
            >;
        };

        game_layer {
            display-name = "GAMING";
            bindings = <
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______                      _______ _______ _______ _______ _______ _______
                                        _______ _______ _______                      _______ _______ _______
            >;
        };

        flag_swap_layer {
            display-name = "FLAG";
            bindings = <
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______                      _______ _______ _______ _______ _______ _______
                                        _______ _______ _______                      _______ _______ _______
            >;
        };
    };
};
