#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/oskey.h>
#include <behaviors/oskey.dtsi>

// Layers
#define _BASE 0
#define _MAC_BASE 1
#define _SYM 2
#define _NAV 3
#define _WIN 4
#define _NUM 5
#define _CONFIG 6
#define _GAME 7
#define _SWAP_FLAG 8

// keys
#define _______ &trans

#define OS_KEY(name, win, mac, lin)                  \
    name: name {                                      \
        compatible = "zmk,behavior-os-key";           \
        #binding-cells = <0>;                         \
        bindings = <win>, <mac>, <lin>;               \
    };

#define KEYS_LEFT 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33
#define KEYS_RIGHT 7 8 9 10 11 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39
#define KEYS_THUMB 40 41 42 43 44 45

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMB>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMB>;
            hold-trigger-on-release;
        };

        // OS aware keys
        // bindings = Win , Mac , Lin
        
        OS_KEY(os_print, &kp W, &kp M, &kp L)
        OS_KEY(os_toggle, &os_sel OS_MAC, &os_sel OS_LIN, &os_sel OS_WIN)
        OS_KEY(delete_word, &kp LC(BACKSPACE), &kp LA(BACKSPACE), &kp LC(BACKSPACE))
        OS_KEY(next_tab, &kp LC(PG_DN), &kp LG(LS(RBRC)), &kp LC(PG_DN))
        OS_KEY(prev_tab, &kp LC(PG_UP), &kp LG(LS(LBRC)), &kp LC(PG_UP))
        OS_KEY(show_apps, &kp LG(TAB), &kp LC(UP), &kp LG(W))
        OS_KEY(win_left, &kp LG(LEFT), &kp LC(LA(LEFT)), &kp LG(LEFT))
        OS_KEY(win_right, &kp LG(RIGHT), &kp LC(LA(RIGHT)), &kp LG(RIGHT))
        OS_KEY(win_up, &kp LG(UP), &kp LC(LA(UP)), &kp LG(UP))
        OS_KEY(win_down, &kp LG(DOWN), &kp LC(LA(DOWN)), &kp LG(DOWN))
        OS_KEY(win_full, &kp LG(UP), &kp LC(LA(RET)), &kp LG(PG_UP))
        OS_KEY(mon_left, &kp LG(LS(LEFT)), &kp LG(LA(LC(LEFT))), &kp LG(LS(LEFT)))
        OS_KEY(mon_right, &kp LG(LS(RIGHT)), &kp LG(LA(LC(RIGHT))), &kp LG(LS(RIGHT)))
        OS_KEY(show_desk, &kp LG(D), &kp F11, &kp LG(D))
        OS_KEY(scrn_shot, &kp PSCRN, &kp LG(LS(N4)), &kp PSCRN)
        OS_KEY(scrn_rec, &kp LG(LS(R)), &kp LG(LS(N5)), &kp LG(LS(R)))
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        swap_layer {
            if-layers = <_SWAP_FLAG>;
            then-layer = <_MAC_BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &kp ESC     &kp Q         &kp W         &kp E           &kp R           &kp T       &mkp MB2           &kp C_VOL_UP     &kp Y       &kp U           &kp I           &kp O           &kp P           &kp PSCRN
                &kp BSPC    &hml LGUI A   &hml LALT S   &hml LSHFT D    &hml LCTRL F    &kp G       &mkp MB1           &kp C_VOL_DN     &kp H       &hmr LCTRL J    &hmr LSHFT K    &hmr LALT L     &hmr LGUI SQT   &kp SEMI
                &kp DEL     &kp Z         &kp X         &kp C           &kp V           &kp B                                           &kp N       &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp CAPS
                                                        &mo _NUM        &lt _NAV TAB    &lt _WIN RET                                    &kp LSHIFT  &lt _SYM SPACE  &mo _CONFIG
            >;
        };

        mac_base_layer {
            display-name = "MAC BASE";
            bindings = <
                _______ _______      _______ _______ _______     _______ _______      _______ _______ _______     _______ _______ _______        _______
                _______ &hml LCTRL A _______ _______ &hml LGUI F _______ _______      _______ _______ &hmr LGUI J _______ _______ &hmr LCTRL SQT _______
                _______ _______      _______ _______ _______     _______                      _______ _______     _______ _______ _______        _______
                                             _______ _______     _______                      _______ _______     _______
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
                _______ &kp CARET &kp HASH  &kp DQT     &kp DLLR    _______     _______             _______ &kp ASTRK   &kp PRCNT   &kp AMPS &kp PIPE   &kp PLUS    _______
                _______ &kp MINUS &kp LT    &kp GT      &kp EQUAL   &kp GRAVE   _______             _______ &kp EXCL    &kp LPAR    &kp RPAR &kp COLON  &kp UNDER   _______
                _______ &kp BSLH  &kp LBKT  &kp RBKT    &kp AT      _______                                 &kp TILDE   &kp LBRC    &kp RBRC _______    &kp QMARK   _______
                                            _______     &kp SPACE   _______                                 _______     _______     _______
            >;
        };

        nav_layer {
            display-name = "NAVIGATON";
            bindings = <
                _______         &kp LC(W)   _______     &prev_tab   &next_tab   _______ _______         _______ _______ &kp HOME        &kp UP      &kp END     _______ &scrn_rec
                &delete_word    _______     _______     _______     _______     _______ _______         _______ _______ &kp LEFT        &kp DOWN    &kp RIGHT   _______ _______
                &ok_redo        &ok_undo    &ok_cut     &ok_copy    &ok_paste                                   _______ &kp LA(LC(L))   _______     _______     _______ _______
                                            _______     _______     _______                                     _______ _______         _______
            >;
        };

        win_layer {
            display-name = "WINMAN";
            bindings = <
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______                      _______ _______ _______ _______ _______ _______
                                        _______ _______ _______                      _______ _______ _______
            >;
        };

        num_layer {
            display-name = "NUMBERS";
            bindings = <
                _______ _______ _______ _______ _______ _______ _______      _______ &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp PLUS  _______
                _______ _______ _______ _______ _______ _______ _______      _______ &kp SLASH  &kp N4  &kp N5  &kp N6  &kp MINUS _______
                _______ _______ _______ _______ _______ _______                      _______    &kp N1  &kp N2  &kp N3  &kp DOT   &kp EQUAL
                                        _______ _______ _______                      &kp N0     _______ _______
            >;
        };

        config_layer {
            display-name = "CONFIG";
            bindings = <
                &bootloader _______ _______ _______ _______ _______ _______      &os_print  _______     &os_sel OS_WIN  &os_sel OS_MAC  &os_sel OS_LIN  _______        &bootloader
                _______     _______ _______ _______ _______ _______ _______      _______    _______     &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3   _______
                _______     _______ _______ _______ _______ _______                         _______     &to _BASE       &to _SWAP_FLAG  _______         _______        &to _GAME
                                            _______ _______ _______                         _______     _______         _______
            >;
        };

        game_layer {
            display-name = "GAMING";
            bindings = <
                _______ _______     _______ &kp W       _______     _______ _______      _______ _______    &kp UP      _______ _______ _______ _______
                _______ &kp LSHIFT  &kp A   &kp S       &kp D       _______ _______      _______ &kp LEFT   &kp DOWN    &kp RIGHT _______ _______ _______
                _______ &kp LCTRL   _______ _______     _______     _______                      _______    _______     _______ _______ _______ _______
                                            _______     &kp SPACE   _______                      _______    &kp SPACE   _______
            >;
        };

        flag_swap_layer {
            display-name = "FLAG";
            bindings = <
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______ _______      _______ _______ _______ _______ _______ _______ _______
                _______ _______ _______ _______ _______ _______                      _______ _______ _______ _______ _______ _______
                                        _______ _______ _______                      _______ _______ _______
            >;
        };
    };
};
